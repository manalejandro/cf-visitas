/**
 * Cloudflare Worker configuration for cf-visitas.
 *
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Before deploying:
 *   1. Create the D1 database:  npx wrangler d1 create cf-visitas
 *   2. Replace `database_id` below with the id returned by that command.
 *   3. Apply migrations:        npm run db:migrate:remote
 *   4. Set the worker secrets:  see README.md → "Configuration"
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-visitas",
	"compatibility_date": "2026-10-07",
	"main": "vinext/server/fetch-handler",

	// ── Static assets (built client) ────────────────────────────────────────
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},

	// ── D1 database ─────────────────────────────────────────────────────────
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf-visitas",
			"database_id": "",
			"migrations_dir": "migrations"
		}
	],

	// ── Custom domain ───────────────────────────────────────────────────────
	"routes": [
		{
			"pattern": "visitas.manalejandro.com",
			"custom_domain": true
		}
	],

	// ── Observability (Workers Logs + traces) ───────────────────────────────
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"upload_source_maps": true,

	// ── Plain environment variables ─────────────────────────────────────────
	"vars": {
		// How often the Worker rotates the tracker encryption key pair (days).
		"TRACKER_KEY_ROTATION_DAYS": "30"
		// Set to "true" if zone features that use eval() (e.g. Cloudflare Zaraz)
		// must run on this hostname — it appends 'unsafe-eval' to the CSP.
		// "CSP_ALLOW_EVAL": "true"
	}

	/**
	 * Environment variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Secrets (ADMIN_USER, ADMIN_PASSWORD, SESSION_SECRET, TRACKER_SIGNING_KEY)
	 * are set with `wrangler secret put` and are never stored in this file.
	 * The tracker encryption key pair is generated by the Worker and stored in D1.
	 */
}
