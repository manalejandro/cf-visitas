# Local development secrets for `wrangler dev` / `vinext dev`.
# Copy this file to `.dev.vars` and fill it with the output of:
#
#   npm run keys:generate
#
# `.dev.vars` is gitignored — never commit real values.
#
# Note: the tracker encryption key pair is generated by the Worker itself and
# stored in D1 — it is not configured here.

ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Random 32+ byte strings (hex or base64).
SESSION_SECRET=""
TRACKER_SIGNING_KEY=""

# Optional: override the tracker key rotation period (days, default 30).
# TRACKER_KEY_ROTATION_DAYS="30"

# Optional: force the origin embedded in /tracker.js. Useful locally because
# Wrangler rewrites the request host to the custom-domain route.
# Use the port of the dev server you are running:
#   8787 → npm run start / npm run preview
#   3001 → npm run dev
TRACKER_ENDPOINT_ORIGIN="http://localhost:8787"
